# ================================================================================
# A sample of the .env file
# Please modify the details here and rename this file as .env before running
# ================================================================================

# Settings associated to Django
# Note: Change to a unique secret key, set debug to false, and configure the allowed host for production deployment
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Code for teacher registration
TEACHER_REGISTRATION_CODE=ADEPTMATH-TEACHER-2026

# Email configuration for sending emails
# Note: Configure these to make sure that email sending can work
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com
